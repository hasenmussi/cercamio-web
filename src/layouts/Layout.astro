---
// 1. Importación de estilos globales
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="CercaMío: El sistema operativo del comercio local. Conecta con tu barrio, estés donde estés." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>{title}</title>
        <!-- Iconos FontAwesome -->
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet">
	</head>
	<body class="font-sans text-gray-800 bg-white transition-colors duration-500">
        
        <!-- NAV FIXED -->
        <nav class="fixed w-full z-50 bg-white/90 backdrop-blur-md border-b border-gray-100 transition-all duration-300">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16 items-center">
                    <!-- Logo -->
					<a href="/" class="flex items-center gap-2 group">
						<img src="/favicon.png" alt="Logo CercaMío" class="w-8 h-8 object-contain group-hover:scale-110 transition-transform duration-300" />
						<span class="text-2xl font-extrabold tracking-tight">
							<span class="text-blue-600">Cerca</span><span class="text-orange-500">Mío</span>
						</span>
					</a>
                    
                    <!-- Enlaces Desktop -->
                    <div class="hidden md:flex space-x-8 items-center">
                        <a href="https://panel.cercamio.app" target="_blank" class="text-sm font-semibold text-gray-600 hover:text-blue-600 transition">
                            Soy Vendedor/Socio
                        </a>
                        <a href="https://play.google.com/store/apps/details?id=com.cercamio.app" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-full text-sm font-bold transition shadow-lg shadow-blue-500/20 transform hover:-translate-y-0.5">
                            Descargar App
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- CONTENIDO -->
        <!-- Agregamos fade-in global para transiciones suaves entre páginas -->
		<main class="animate-[fadeIn_0.5s_ease-out]">
            <slot />
        </main>

        <!-- FOOTER GLOBAL (ACTUALIZADO V3.1 - CON MISIÓN) 🌐 -->
        <footer class="bg-gray-900 text-gray-400 py-16 border-t border-gray-800 relative overflow-hidden">
            
            <!-- Decoración sutil footer -->
            <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>

            <div class="max-w-7xl mx-auto px-4 grid md:grid-cols-4 gap-10 relative z-10">
                
                <!-- COLUMNA 1: MARCA -->
                <div class="col-span-1 md:col-span-1">
                    <div class="flex items-center gap-2 mb-4">
					    <img src="/favicon.png" alt="Logo" class="w-8 h-8 brightness-0 invert opacity-90" />
					    <span class="text-2xl font-bold text-white tracking-tight">CercaMío</span>
					</div>
                    <p class="text-sm leading-relaxed text-gray-500 mb-6">
                        El sistema operativo del comercio local.<br>Argentina.
                    </p>
                    
                    <!-- REDES SOCIALES (ICONOS) -->
                    <div class="flex gap-4">
                        <a href="https://www.facebook.com/share/1DgGMjFT5A/" target="_blank" class="social-link w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center text-white hover:bg-[#1877F2] transition duration-300" data-app="fb://facewebmodal/f?href=https://www.facebook.com/share/1DgGMjFT5A/">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://instagram.com/cercamio.app" target="_blank" class="social-link w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center text-white hover:bg-gradient-to-tr hover:from-orange-500 hover:via-pink-500 hover:to-purple-600 transition duration-300" data-app="instagram://user?username=cercamio.app">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="https://tiktok.com/@cercamio.app" target="_blank" class="social-link w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center text-white hover:bg-black hover:text-cyan-400 transition duration-300 border border-transparent hover:border-cyan-400" data-app="snssdk1233://user/profile/cercamio.app">
                            <i class="fab fa-tiktok"></i>
                        </a>
                        <a href="https://x.com/CercaMioApp" target="_blank" class="social-link w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center text-white hover:bg-black border border-transparent hover:border-white transition duration-300" data-app="twitter://user?screen_name=CercaMioApp">
                            <i class="fab fa-x-twitter"></i>
                        </a>
                    </div>
                </div>

                <!-- COLUMNA 2: COMPAÑÍA (Misión + Legal) -->
                <div>
                    <h4 class="text-white font-bold mb-6 tracking-wide uppercase text-xs">Compañía</h4>
                    <ul class="space-y-3 text-sm">
                        <!-- 🔥 LINK NUEVO A MISIÓN -->
                        <li>
                            <a href="/mision" class="hover:text-blue-400 transition flex items-center gap-2 group">
                                <span>Nuestra Misión</span>
                                <i class="fas fa-heart text-xs text-pink-500 opacity-0 group-hover:opacity-100 transition-opacity"></i>
                            </a>
                        </li>
                        <li><a href="/privacidad" class="hover:text-white transition">Política de Privacidad</a></li>
                        <li><a href="/privacidad#terminos" class="hover:text-white transition">Términos y Condiciones</a></li>
                    </ul>
                </div>

                <!-- COLUMNA 3: AYUDA -->
                <div>
                    <h4 class="text-white font-bold mb-6 tracking-wide uppercase text-xs">Soporte</h4>
                    <ul class="space-y-3 text-sm">
                        <li><a href="/eliminar-datos" class="hover:text-white text-red-400 transition font-medium">Solicitar borrar datos</a></li>
                        <li><a href="mailto:soporte@cercamio.app" class="hover:text-white transition">Centro de Ayuda</a></li>
                        <li><a href="https://panel.cercamio.app" class="hover:text-white transition">Acceso Vendedores</a></li>
                    </ul>
                </div>

                <!-- COLUMNA 4: DESCARGA -->
                <div>
                    <h4 class="text-white font-bold mb-6 tracking-wide uppercase text-xs">Obtén la App</h4>
                    <a href="https://play.google.com/store/apps/details?id=com.cercamio.app" target="_blank" class="block w-40 opacity-80 hover:opacity-100 transition duration-300 hover:scale-105">
                         <div class="bg-white/10 border border-white/20 rounded-lg p-2 flex items-center gap-2">
                             <i class="fab fa-google-play text-2xl text-white"></i>
                             <div class="text-left">
                                 <div class="text-[8px] uppercase text-gray-400">Disponible en</div>
                                 <div class="text-xs font-bold text-white">Google Play</div>
                             </div>
                         </div>
                    </a>
                </div>

            </div>
            
            <div class="text-center text-xs mt-16 pt-8 border-t border-gray-800 text-gray-600 flex flex-col md:flex-row justify-center gap-4">
                <span>&copy; 2026 CercaMío. Todos los derechos reservados.</span>
                <span class="hidden md:inline text-gray-700">|</span>
                <span>Hecho con 🧉 en Argentina</span>
            </div>
        </footer>

        <!-- SCRIPT INTELIGENTE: WEB vs APP 🧠 -->
        <script is:inline>
            const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
            if (isMobile) {
                const socialLinks = document.querySelectorAll('.social-link');
                socialLinks.forEach(link => {
                    link.addEventListener('click', (e) => {
                        const appUrl = link.getAttribute('data-app');
                        // Intento pasivo: Dejamos que el href funcione como fallback
                    });
                });
            }
        </script>
	</body>
</html>