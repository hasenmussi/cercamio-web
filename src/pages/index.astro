---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import appMockup from '../assets/app-mockup.png';
---

<Layout title="CercaMío - Tu barrio, conectado.">
	
    <!-- 1. HERO SECTION (V2.0 - Coming Soon) -->
    <header class="pt-32 pb-20 lg:pt-48 lg:pb-32 bg-gradient-to-b from-blue-50/80 via-white to-white overflow-hidden relative">
        
        <!-- Elementos decorativos de fondo -->
        <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-bl from-orange-100/40 to-transparent -z-10 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-1/3 h-full bg-gradient-to-tr from-blue-100/40 to-transparent -z-10 blur-3xl"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center gap-16">
            
            <!-- TEXTO HERO -->
            <div class="w-full md:w-1/2 text-center md:text-left z-10 relative">
                
                <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 text-xs font-bold tracking-widest text-orange-600 uppercase bg-orange-50 border border-orange-100 rounded-full shadow-sm">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
                    </span>
                    La evolución del comercio local
                </div>
                
                <h1 class="text-5xl lg:text-7xl font-extrabold text-gray-900 leading-[1.1] mb-6 tracking-tight">
                    Tu barrio, <br>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">conectado.</span>
                </h1>
                
                <p class="text-xl text-gray-600 mb-10 max-w-lg mx-auto md:mx-0 leading-relaxed font-medium">
                    La SuperApp que une a vecinos con comercios, servicios y oportunidades cercanas. Descubre, compra y conecta en segundos.
                </p>
                
                <!-- ZONA DE DESCARGA (CON BLOQUEO "PRÓXIMAMENTE") -->
                <div class="relative inline-block group">
                    <!-- Botón "Falso" de fondo para estructura -->
                    <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start opacity-50 blur-[2px] grayscale transition duration-500">
                        <a href="#" class="flex items-center justify-center bg-black text-white px-8 py-4 rounded-2xl cursor-default">
                            <i class="fab fa-google-play text-3xl mr-4"></i>
                            <div class="text-left">
                                <div class="text-[10px] uppercase tracking-wider">Disponible en</div>
                                <div class="font-bold text-xl leading-none">Google Play</div>
                            </div>
                        </a>
                    </div>

                    <!-- OVERLAY "PRÓXIMAMENTE" -->
                    <div class="absolute inset-0 flex items-center justify-center md:justify-start">
                        <div class="bg-white/90 backdrop-blur-md border border-white/20 shadow-xl px-6 py-3 rounded-full flex items-center gap-3 transform hover:scale-105 transition duration-300 cursor-default">
                            <span class="text-2xl">🚀</span>
                            <div>
                                <p class="text-sm font-bold text-gray-900 leading-none">¡Lanzamiento Inminente!</p>
                                <p class="text-[10px] text-gray-500 font-medium uppercase tracking-wide mt-1">Muy pronto en tu ciudad</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- IMAGEN MOCKUP (GIGANTE) -->
            <div class="w-full md:w-1/2 flex justify-center relative mt-12 md:mt-0">
                <div class="relative transform rotate-[-6deg] hover:rotate-0 transition-transform duration-700 ease-out z-10">
                    <Image 
                        src={appMockup} 
                        alt="Captura de pantalla de CercaMío" 
                        class="w-[280px] md:w-[320px] h-auto drop-shadow-2xl"
                        width={600} 
                        quality="high"
                        loading="eager" 
                    />
                    <!-- Badge Flotante -->
                        <div class="absolute -right-8 top-20 bg-white p-3 rounded-2xl shadow-xl animate-bounce hidden md:block">
                        <span class="text-2xl">🔥</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- 2. MAPA INTELIGENTE (DESTACADO V2) -->
    <section class="py-24 bg-white relative">
        <div class="max-w-7xl mx-auto px-4">
            <div class="bg-gradient-to-br from-blue-600 to-blue-800 rounded-[2.5rem] p-8 md:p-16 text-white shadow-2xl relative overflow-hidden group">
                
                <!-- Fondo decorativo mapa -->
                <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/map-markers.png')]"></div>
                
                <div class="relative z-10 flex flex-col md:flex-row items-center gap-12">
                    <div class="md:w-3/5">
                        <div class="inline-flex items-center gap-2 bg-blue-500/30 backdrop-blur-sm px-4 py-1.5 rounded-full text-blue-100 text-sm font-bold mb-6 border border-blue-400/30">
                            <i class="fas fa-map-marked-alt"></i> La función estrella
                        </div>
                        <h2 class="text-3xl md:text-5xl font-extrabold mb-6 leading-tight">
                            Ser visto por toda la ciudad <br>nunca fue tan fácil.
                        </h2>
                        <p class="text-blue-100 text-lg md:text-xl mb-8 leading-relaxed max-w-2xl">
                            Ya sea que tengas una ferretería, vendas tortas desde casa o seas plomero. 
                            Nuestro <strong>Mapa Inteligente</strong> y el feed <strong>Explorar</strong> te ponen en el radar de miles de vecinos en tiempo real.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <div class="bg-white/10 backdrop-blur-md px-5 py-3 rounded-xl border border-white/10 flex items-center gap-3">
                                <i class="fas fa-store text-orange-400"></i>
                                <span class="font-medium">Locales</span>
                            </div>
                            <div class="bg-white/10 backdrop-blur-md px-5 py-3 rounded-xl border border-white/10 flex items-center gap-3">
                                <i class="fas fa-tools text-green-400"></i>
                                <span class="font-medium">Servicios</span>
                            </div>
                            <div class="bg-white/10 backdrop-blur-md px-5 py-3 rounded-xl border border-white/10 flex items-center gap-3">
                                <i class="fas fa-cookie-bite text-pink-400"></i>
                                <span class="font-medium">Emprendedores</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Icono Gigante 3D -->
                    <div class="md:w-2/5 flex justify-center">
                        <div class="w-48 h-48 md:w-64 md:h-64 bg-white/10 backdrop-blur-xl rounded-full flex items-center justify-center border border-white/20 shadow-[0_0_50px_rgba(255,255,255,0.2)] group-hover:scale-110 transition duration-500">
                            <i class="fas fa-location-dot text-8xl md:text-9xl text-orange-500 drop-shadow-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. SECCIÓN PARA COMPRADORES (CLARA Y AMIGABLE) -->
    <section class="py-24 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-16">
                <span class="text-blue-600 font-bold tracking-wider uppercase text-sm">Para Vecinos</span>
                <h2 class="text-4xl font-extrabold text-gray-900 mt-2">Compra mejor, vive mejor.</h2>
                <p class="text-gray-500 mt-4 max-w-2xl mx-auto">Diseñamos una experiencia de compra pensada para ahorrarte tiempo y dinero.</p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Beneficio 1 -->
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-lg transition group">
                    <div class="w-14 h-14 bg-orange-50 rounded-2xl flex items-center justify-center mb-6 text-orange-500 text-2xl group-hover:scale-110 transition">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Ofertas Flash</h3>
                    <p class="text-gray-500 text-sm">Accede a descuentos explosivos por tiempo limitado. Busca el fueguito 🔥 en el mapa y ahorra.</p>
                </div>
                <!-- Beneficio 2 -->
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-lg transition group">
                    <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mb-6 text-blue-600 text-2xl group-hover:scale-110 transition">
                        <i class="fas fa-bullhorn"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Megáfono Barrial</h3>
                    <p class="text-gray-500 text-sm">¿Buscas algo específico? Pregunta a todos los comercios a la vez y recibe presupuestos al instante.</p>
                </div>
                <!-- Beneficio 3 -->
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-lg transition group">
                    <div class="w-14 h-14 bg-red-50 rounded-2xl flex items-center justify-center mb-6 text-red-500 text-2xl group-hover:scale-110 transition">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Tus Favoritos</h3>
                    <p class="text-gray-500 text-sm">Guarda los locales que amas. Entérate primero de sus novedades, cambios de horario y promos.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. SECCIÓN PARA VENDEDORES (OSCURA Y PRO) -->
    <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
        <!-- Decoración -->
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-gray-800 via-gray-900 to-black opacity-50"></div>
        
        <div class="max-w-7xl mx-auto px-4 relative z-10">
            <div class="flex flex-col md:flex-row items-center justify-between mb-16 gap-8">
                <div class="md:w-1/2">
                    <span class="text-orange-500 font-bold tracking-wider uppercase text-sm">Para Comercios y Profesionales</span>
                    <h2 class="text-4xl lg:text-5xl font-extrabold mt-2 leading-tight">Potencia tu negocio.<br>Domina tu zona.</h2>
                </div>
                <div class="md:w-1/2 md:text-right">
                    <p class="text-gray-400 text-lg max-w-md ml-auto">
                        Herramientas profesionales para vender más, fidelizar clientes y gestionar tu stock desde el celular o la web.
                    </p>
                    <a href="https://panel.cercamio.app" class="inline-block mt-6 bg-white text-gray-900 px-6 py-3 rounded-lg font-bold hover:bg-gray-200 transition">
                        Acceder al Panel Web
                    </a>
                </div>
            </div>

            <div class="grid md:grid-cols-4 gap-6">
                <div class="bg-gray-800/50 p-6 rounded-2xl border border-gray-700 hover:bg-gray-800 transition">
                    <i class="fas fa-camera text-purple-400 text-3xl mb-4"></i>
                    <h3 class="font-bold text-lg mb-2">Historias</h3>
                    <p class="text-gray-400 text-xs">Sube fotos de tus productos o trabajos realizados al feed Explorar.</p>
                </div>
                <div class="bg-gray-800/50 p-6 rounded-2xl border border-gray-700 hover:bg-gray-800 transition">
                    <i class="fas fa-rocket text-amber-400 text-3xl mb-4"></i>
                    <h3 class="font-bold text-lg mb-2">Misiones Rockstar</h3>
                    <p class="text-gray-400 text-xs">Completa retos, sube de nivel y desbloquea beneficios premium gratis.</p>
                </div>
                <div class="bg-gray-800/50 p-6 rounded-2xl border border-gray-700 hover:bg-gray-800 transition">
                    <i class="fas fa-tags text-green-400 text-3xl mb-4"></i>
                    <h3 class="font-bold text-lg mb-2">Marketing</h3>
                    <p class="text-gray-400 text-xs">Crea Ofertas Flash y Especiales para liquidar stock rápidamente.</p>
                </div>
                <div class="bg-gray-800/50 p-6 rounded-2xl border border-gray-700 hover:bg-gray-800 transition">
                    <i class="fas fa-comments text-blue-400 text-3xl mb-4"></i>
                    <h3 class="font-bold text-lg mb-2">Interacción</h3>
                    <p class="text-gray-400 text-xs">Responde preguntas y atiende solicitudes del Megáfono en tiempo real.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- NUEVA SECCIÓN: EDUCACIÓN DIGITAL (HUMANIZANDO LA TECNOLOGÍA) -->
    <section class="py-24 bg-white border-t border-gray-100">
        <div class="max-w-6xl mx-auto px-4">
            
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-orange-500 font-bold tracking-wider uppercase text-sm">El Futuro es Hoy</span>
                <h2 class="text-3xl lg:text-4xl font-extrabold text-gray-900 mt-2 mb-6">
                    Digitalizarse no significa complicarse.
                </h2>
                <p class="text-lg text-gray-500 leading-relaxed">
                    En esta era, la tecnología es el puente entre tu negocio y tus vecinos. 
                    Diseñamos CercaMío para que sea tan natural como una charla en el mostrador.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-10">
                
                <!-- Pila 1: Importancia -->
                <div class="relative bg-blue-50/50 p-8 rounded-3xl border border-blue-100 hover:shadow-lg transition duration-300">
                    <div class="absolute -top-6 left-8 bg-blue-600 text-white w-12 h-12 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/30">
                        <i class="fas fa-globe text-xl"></i>
                    </div>
                    <h3 class="mt-4 text-xl font-bold text-gray-900 mb-3">¿Por qué ahora?</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Tus vecinos ya están en el celular. Digitalizar tu vidriera permite que te encuentren 24/7, incluso cuando tienes la persiana baja. No pierdas ventas por no ser visible.
                    </p>
                </div>

                <!-- Pila 2: Accesibilidad (Edad) -->
                <div class="relative bg-orange-50/50 p-8 rounded-3xl border border-orange-100 hover:shadow-lg transition duration-300">
                    <div class="absolute -top-6 left-8 bg-orange-500 text-white w-12 h-12 rounded-2xl flex items-center justify-center shadow-lg shadow-orange-500/30">
                        <i class="fas fa-universal-access text-xl"></i>
                    </div>
                    <h3 class="mt-4 text-xl font-bold text-gray-900 mb-3">Para todas las edades</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        ¿Sabes usar WhatsApp? Entonces sabes usar CercaMío. Interfaz grande, clara e intuitiva. Sin palabras raras ni menús complicados. Tecnología apta para todo público.
                    </p>
                </div>

                <!-- Pila 3: Beneficios Reales -->
                <div class="relative bg-green-50/50 p-8 rounded-3xl border border-green-100 hover:shadow-lg transition duration-300">
                    <div class="absolute -top-6 left-8 bg-green-600 text-white w-12 h-12 rounded-2xl flex items-center justify-center shadow-lg shadow-green-500/30">
                        <i class="fas fa-chart-line text-xl"></i>
                    </div>
                    <h3 class="mt-4 text-xl font-bold text-gray-900 mb-3">Beneficios Reales</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Para el <strong>Comercio</strong>: Control total y nuevos clientes.<br>
                        Para el <strong>Vecino</strong>: Ahorro de tiempo y dinero.<br>
                        Para el <strong>Barrio</strong>: El dinero circula y crece dentro de la comunidad local.
                    </p>
                </div>

            </div>

            <!-- Frase de cierre -->
            <div class="mt-16 text-center">
                <p class="text-2xl font-serif italic text-gray-400">
                    "La tecnología no reemplaza al barrio, lo conecta."
                </p>
            </div>

        </div>
    </section>

    <!-- 6. NUESTRO PROPÓSITO (IMPACTO SOCIAL & ROADMAP) ❤️ -->
    <section class="py-24 bg-gradient-to-br from-indigo-900 to-slate-900 text-white relative overflow-hidden">
        
        <!-- Decoración sutil -->
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
        <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-white to-transparent opacity-10"></div>

        <div class="max-w-7xl mx-auto px-4 relative z-10">
            
            <div class="text-center max-w-3xl mx-auto mb-20">
                <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/20 text-xs font-bold tracking-widest uppercase mb-4 text-pink-300">
                    Más que una App
                </span>
                <h2 class="text-4xl lg:text-5xl font-extrabold mb-6 leading-tight">
                    Tu compra tiene poder.
                </h2>
                <p class="text-lg text-indigo-200 leading-relaxed">
                    CercaMío es un motor de regeneración social. Cada vez que usas la app, estás financiando el futuro de tu comunidad. Estas son nuestras metas:
                </p>
            </div>

            <!-- TARJETAS DE PROYECTOS (FUTURO) -->
            <div class="grid md:grid-cols-3 gap-8">
                
                <!-- CAUSA 1: REFUGIO (Vida) -->
                <div class="bg-white/5 backdrop-blur-sm p-8 rounded-3xl border border-white/10 hover:bg-white/10 transition duration-500 hover:-translate-y-2 group relative overflow-hidden">
                    <div class="absolute top-4 right-4 bg-pink-500/20 text-pink-300 text-[10px] font-bold px-2 py-1 rounded border border-pink-500/30">
                        META 2028
                    </div>
                    <div class="w-16 h-16 bg-pink-500/20 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition">
                        <i class="fas fa-paw text-3xl text-pink-400"></i>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Refugio Modelo</h3>
                    <p class="text-indigo-200 text-sm leading-relaxed mb-6">
                        Construiremos un centro de rescate y rehabilitación animal de vanguardia. Vacunación, Castración, Entrenamiento, y adopción responsable.
                    </p>
                    <div class="w-full bg-white/10 rounded-full h-2 mb-2 overflow-hidden">
                        <div class="bg-pink-500 h-2 rounded-full w-[1%]"></div> 
                    </div>
                    <p class="text-xs text-pink-300 font-bold uppercase tracking-wider">Fase: Recaudación Inicial</p>
                </div>

                <!-- CAUSA 2: OPORTUNIDAD (Personas) -->
                <div class="bg-white/5 backdrop-blur-sm p-8 rounded-3xl border border-white/10 hover:bg-white/10 transition duration-500 hover:-translate-y-2 group relative overflow-hidden">
                    <div class="absolute top-4 right-4 bg-blue-500/20 text-blue-300 text-[10px] font-bold px-2 py-1 rounded border border-blue-500/30">
                        META 2028
                    </div>
                    <div class="w-16 h-16 bg-blue-500/20 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition">
                        <i class="fas fa-user-graduate text-3xl text-blue-400"></i>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Academia de Oficios</h3>
                    <p class="text-indigo-200 text-sm leading-relaxed mb-6">
                        Un hogar-escuela para personas en situación de calle. Capacitación técnica y financiamiento para que lancen sus propios micro-negocios en la App.
                    </p>
                    <div class="w-full bg-white/10 rounded-full h-2 mb-2 overflow-hidden">
                        <div class="bg-blue-500 h-2 rounded-full w-[1%]"></div>
                    </div>
                    <p class="text-xs text-blue-300 font-bold uppercase tracking-wider">Fase: Planificación</p>
                </div>

                <!-- CAUSA 3: CRECIMIENTO (Comercios) -->
                <div class="bg-white/5 backdrop-blur-sm p-8 rounded-3xl border border-white/10 hover:bg-white/10 transition duration-500 hover:-translate-y-2 group relative overflow-hidden">
                    <div class="absolute top-4 right-4 bg-amber-500/20 text-amber-300 text-[10px] font-bold px-2 py-1 rounded border border-amber-500/30">
                        META 2027
                    </div>
                    <div class="w-16 h-16 bg-amber-500/20 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition">
                        <i class="fas fa-hand-holding-dollar text-3xl text-amber-400"></i>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Fondo de Crédito</h3>
                    <p class="text-indigo-200 text-sm leading-relaxed mb-6">
                        Micro-créditos a tasa justa para nuestros vendedores. Financiaremos la compra de stock o mejoras del local con las propias ganancias de la plataforma.
                    </p>
                    <div class="w-full bg-white/10 rounded-full h-2 mb-2 overflow-hidden">
                        <div class="bg-amber-500 h-2 rounded-full w-[5%]"></div>
                    </div>
                    <p class="text-xs text-amber-300 font-bold uppercase tracking-wider">Fase: Estructuración</p>
                </div>

            </div>

            <!-- ROADMAP VISUAL (LÍNEA DE TIEMPO ACTUALIZADA) 🗺️ -->
            <div class="mt-24">
                <div class="text-center mb-12">
                    <h3 class="text-2xl font-bold text-white">Nuestra Hoja de Ruta</h3>
                    <div class="h-1 w-20 bg-pink-500 mx-auto mt-4 rounded-full"></div>
                </div>

                <div class="max-w-3xl mx-auto">
                    
                    <!-- HITO 1: 2026 (EL PRESENTE) -->
                    <div class="flex gap-6">
                        <div class="flex flex-col items-center">
                            <div class="w-8 h-8 rounded-full bg-pink-500 flex items-center justify-center shadow-[0_0_15px_rgba(236,72,153,0.6)] z-10">
                                <i class="fas fa-rocket text-white text-xs"></i>
                            </div>
                            <div class="w-0.5 h-full bg-gradient-to-b from-pink-500 to-white/10"></div>
                        </div>
                        <div class="pb-12">
                            <span class="text-pink-300 font-bold text-sm tracking-widest">ENERO • 2026</span>
                            <h4 class="text-xl font-bold text-white mt-1">Lanzamiento Oficial</h4>
                            <p class="text-indigo-200 text-sm mt-2 leading-relaxed">
                                Apertura a producción en Comodoro Rivadavia. Activación del ecosistema digital, sistema de socios y validación del modelo híbrido.
                            </p>
                        </div>
                    </div>

                    <!-- HITO 2: 2027 (EXPANSIÓN) -->
                    <div class="flex gap-6">
                        <div class="flex flex-col items-center">
                            <div class="w-8 h-8 rounded-full bg-slate-800 border border-white/20 flex items-center justify-center z-10">
                                <span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>
                            </div>
                            <div class="w-0.5 h-full bg-white/10"></div>
                        </div>
                        <div class="pb-12 opacity-90">
                            <span class="text-amber-300 font-bold text-sm tracking-widest">PROYECCIÓN • 2027</span>
                            <h4 class="text-xl font-bold text-white mt-1">Fondo de Crédito & Regionalización</h4>
                            <p class="text-indigo-200 text-sm mt-2 leading-relaxed">
                                Expansión a ciudades satélite de la Patagonia. Lanzamiento del programa de micro-créditos para potenciar a los comerciantes de la red.
                            </p>
                        </div>
                    </div>

                    <!-- HITO 3: 2028 (VISIÓN FÍSICA) -->
                    <div class="flex gap-6">
                        <div class="flex flex-col items-center">
                            <div class="w-8 h-8 rounded-full bg-slate-800 border border-white/10 flex items-center justify-center z-10">
                                <i class="fas fa-star text-white/30 text-xs"></i>
                            </div>
                        </div>
                        <div class="opacity-60">
                            <span class="text-blue-300 font-bold text-sm tracking-widest">VISIÓN • 2028</span>
                            <h4 class="text-xl font-bold text-white mt-1">Impacto Social Tangible</h4>
