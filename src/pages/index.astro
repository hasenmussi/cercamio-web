    <!-- SCRIPT DE INTERACTIVIDAD (SIMPLE Y ROBUSTO) -->
    <script is:inline>
        function toggleTab(tab) {
            const bg = document.getElementById('switch-bg');
            const btnVecino = document.getElementById('btn-vecino');
            const btnVendedor = document.getElementById('btn-vendedor');
            const contentVecino = document.getElementById('content-vecino');
            const contentVendedor = document.getElementById('content-vendedor');

            if (tab === 'vecino') {
                // 1. Mover fondo
                bg.style.transform = 'translateX(0)';
                bg.classList.remove('bg-purple-600');
                bg.classList.add('bg-blue-600');

                // 2. Estilos Botones
                btnVecino.classList.add('text-white');
                btnVecino.classList.remove('text-slate-500');
                btnVendedor.classList.remove('text-white');
                btnVendedor.classList.add('text-slate-500');

                // 3. MOSTRAR VECINO
                contentVecino.classList.remove('hidden');
                contentVecino.classList.add('grid'); // 🔥 AGREGAMOS GRID AQUÍ
                
                // Pequeño delay para la opacidad (Fade In)
                setTimeout(() => {
                    contentVecino.classList.remove('opacity-0');
                    contentVecino.classList.add('opacity-100');
                }, 10);
                
                // 4. OCULTAR VENDEDOR
                contentVendedor.classList.remove('opacity-100');
                contentVendedor.classList.add('opacity-0');
                
                // Esperamos la transición y luego ocultamos
                setTimeout(() => {
                    contentVendedor.classList.remove('grid'); // 🔥 QUITAMOS GRID AQUÍ
                    contentVendedor.classList.add('hidden');
                }, 300);

            } else {
                // 1. Mover fondo
                bg.style.transform = 'translateX(100%)';
                bg.classList.remove('bg-blue-600');
                bg.classList.add('bg-purple-600');

                // 2. Estilos Botones
                btnVendedor.classList.add('text-white');
                btnVendedor.classList.remove('text-slate-500');
                btnVecino.classList.remove('text-white');
                btnVecino.classList.add('text-slate-500');

                // 3. MOSTRAR VENDEDOR
                contentVendedor.classList.remove('hidden');
                contentVendedor.classList.add('grid'); // 🔥 AGREGAMOS GRID AQUÍ
                
                setTimeout(() => {
                    contentVendedor.classList.remove('opacity-0');
                    contentVendedor.classList.add('opacity-100');
                }, 10);

                // 4. OCULTAR VECINO
                contentVecino.classList.remove('opacity-100');
                contentVecino.classList.add('opacity-0');
                
                setTimeout(() => {
                    contentVecino.classList.remove('grid'); // 🔥 QUITAMOS GRID AQUÍ
                    contentVecino.classList.add('hidden');
                }, 300);
            }
        }
    </script>

