---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import appMockup from '../assets/app_mockup.png';
---

<Layout title="CercaMío - Tu barrio, conectado.">
	
    <!-- 1. HERO SECTION (V3.0 - LANZAMIENTO OFICIAL 🚀) -->
    <header class="relative pt-32 pb-20 lg:pt-48 lg:pb-40 overflow-hidden">
        
        <!-- Fondo Premium (Mesh Gradient) -->
        <div class="absolute inset-0 bg-white">
            <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-blue-100/50 rounded-full blur-[100px] opacity-70"></div>
            <div class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-orange-50/50 rounded-full blur-[120px] opacity-60"></div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
                
                <!-- COLUMNA IZQUIERDA: COPYWRITING DE IMPACTO -->
                <div class="w-full lg:w-1/2 text-center lg:text-left">
                    
                    <!-- Badge de Estado -->
                    <div class="inline-flex items-center gap-2 px-4 py-2 mb-8 bg-white border border-gray-200 rounded-full shadow-sm hover:shadow-md transition-shadow cursor-default">
                        <span class="relative flex h-3 w-3">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                        </span>
                        <span class="text-xs font-bold tracking-wider text-gray-600 uppercase">Disponible en Argentina</span>
                    </div>
                    
                    <!-- Título Principal -->
                    <h1 class="text-5xl lg:text-7xl font-extrabold text-slate-900 leading-[1.1] mb-6 tracking-tight">
                        Tu barrio, <br>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-orange-500">
                            conectado.
                        </span>
                    </h1>
                    
                    <p class="text-lg lg:text-xl text-slate-600 mb-10 leading-relaxed max-w-xl mx-auto lg:mx-0">
                        Olvídate de tener mil apps. Desde <strong>pedir una hamburguesa hasta reservar turno en la peluquería</strong>. Todo lo que necesitas en tu ciudad, en un solo lugar.
                    </p>
                    
                    <!-- BOTONES DE ACCIÓN (CONVERSION) -->
                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center">
                        
                        <!-- Botón Google Play (Real) -->
                        <!-- ⚠️ PEGAR LINK DE LA STORE EN HREF -->
                        <a href="https://play.google.com/store/apps/details?id=com.cercamio.app" target="_blank" 
                           class="group flex items-center bg-gray-900 text-white px-7 py-3.5 rounded-xl hover:bg-black transition-all shadow-xl hover:shadow-2xl hover:-translate-y-1 active:scale-95 duration-300">
                            <i class="fab fa-google-play text-3xl mr-3 text-white group-hover:text-green-400 transition-colors"></i>
                            <div class="text-left">
                                <div class="text-[10px] uppercase tracking-wider opacity-80">Descárgala en</div>
                                <div class="font-bold text-lg leading-none">Google Play</div>
                            </div>
                        </a>

                        <!-- Botón Secundario (Vendedores) -->
                        <a href="https://panel.cercamio.app" class="px-7 py-4 rounded-xl font-bold text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition flex items-center gap-2">
                            Soy Vendedor <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                    </div>

                    <!-- Prueba Social (Trust) -->
                   <!-- <div class="mt-8 flex items-center justify-center lg:justify-start gap-4 text-sm text-gray-500">
                        <div class="flex -space-x-2">
                            <div class="w-8 h-8 rounded-full bg-gray-200 border-2 border-white"></div>
                            <div class="w-8 h-8 rounded-full bg-gray-300 border-2 border-white"></div>
                            <div class="w-8 h-8 rounded-full bg-gray-400 border-2 border-white flex items-center justify-center text-[10px] font-bold text-white">+1k</div>
                        </div>
                        <p>Vecinos ya la están usando.</p>
                    </div>-->

                </div>

                <!-- COLUMNA DERECHA: MOCKUP 3D INTERACTIVO -->
                <div class="w-full lg:w-1/2 flex justify-center relative mt-16 lg:mt-0 perspective-1000">
                    
                    <!-- Glow Trasero -->
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-blue-500/20 rounded-full blur-[80px]"></div>

                    <div class="relative transform transition-transform duration-700 hover:scale-105 hover:rotate-0 rotate-[-3deg]">
                        
                        <!-- EL TELÉFONO -->
                        <Image 
                            src={appMockup} 
                            alt="App CercaMío en funcionamiento" 
                            class="w-[280px] md:w-[380px] lg:w-[420px] h-auto mx-auto relative z-10 drop-shadow-[0_20px_45px_rgba(0,0,0,0.6)] transition-all duration-500 hover:drop-shadow-[0_35px_65px_rgba(0,0,0,0.7)]"
                            width={800} 
                            quality="high"
                            loading="eager" 
                        />

                        <!-- WIDGET FLOTANTE 1: Oferta (Visible en Móvil) -->
                        <div class="absolute -right-2 md:-right-6 top-10 md:top-20 bg-white/95 backdrop-blur-md p-3 rounded-2xl shadow-lg border border-white/40 animate-bounce z-20 scale-90 md:scale-100" style="animation-duration: 3s;">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center text-orange-600">
                                    <i class="fas fa-fire"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-500 font-bold">Oferta Flash</p>
                                    <p class="text-sm font-black text-gray-800">-50% OFF</p>
                                </div>
                            </div>
                        </div>

                        <!-- WIDGET FLOTANTE 2: Agenda (Visible en Móvil) -->
                        <div class="absolute -left-2 md:-left-10 bottom-10 md:bottom-32 bg-white/95 backdrop-blur-md p-3 rounded-2xl shadow-lg border border-white/40 z-20 animate-pulse scale-90 md:scale-100" style="animation-duration: 4s;">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center text-purple-600">
                                    <i class="fas fa-calendar-check"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-500 font-bold">Turno Confirmado</p>
                                    <p class="text-sm font-black text-gray-800">Hoy 15:00hs</p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- 2. MAPA INTELIGENTE (DESTACADO V2) -->
    <section class="py-24 bg-white relative">
        <div class="max-w-7xl mx-auto px-4">
            <div class="bg-gradient-to-br from-blue-600 to-blue-800 rounded-[2.5rem] p-8 md:p-16 text-white shadow-2xl relative overflow-hidden group">
                
                <!-- Fondo decorativo mapa -->
                <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/map-markers.png')]"></div>
                
                <div class="relative z-10 flex flex-col md:flex-row items-center gap-12">
                    <div class="md:w-3/5">
                        <div class="inline-flex items-center gap-2 bg-blue-500/30 backdrop-blur-sm px-4 py-1.5 rounded-full text-blue-100 text-sm font-bold mb-6 border border-blue-400/30">
                            <i class="fas fa-map-marked-alt"></i> La función estrella
                        </div>
                        <h2 class="text-3xl md:text-5xl font-extrabold mb-6 leading-tight">
                            Ser visto por toda la ciudad <br>nunca fue tan fácil.
                        </h2>
                        <p class="text-blue-100 text-lg md:text-xl mb-8 leading-relaxed max-w-2xl">
                            Ya sea que tengas un Local, vendas tortas desde casa o seas plomero. 
                            Nuestro <strong>Mapa Inteligente</strong> y el feed <strong>Explorar</strong> te ponen en el radar de miles de vecinos en tiempo real.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <div class="bg-white/10 backdrop-blur-md px-5 py-3 rounded-xl border border-white/10 flex items-center gap-3">
                                <i class="fas fa-store text-orange-400"></i>
                                <span class="font-medium">Locales</span>
                            </div>
                            <div class="bg-white/10 backdrop-blur-md px-5 py-3 rounded-xl border border-white/10 flex items-center gap-3">
                                <i class="fas fa-tools text-green-400"></i>
                                <span class="font-medium">Servicios</span>
                            </div>
                            <div class="bg-white/10 backdrop-blur-md px-5 py-3 rounded-xl border border-white/10 flex items-center gap-3">
                                <i class="fas fa-cookie-bite text-pink-400"></i>
                                <span class="font-medium">Emprendedores</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Icono Gigante 3D -->
                    <div class="md:w-2/5 flex justify-center">
                        <div class="w-48 h-48 md:w-64 md:h-64 bg-white/10 backdrop-blur-xl rounded-full flex items-center justify-center border border-white/20 shadow-[0_0_50px_rgba(255,255,255,0.2)] group-hover:scale-110 transition duration-500">
                            <i class="fas fa-location-dot text-8xl md:text-9xl text-orange-500 drop-shadow-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. SECCIÓN PARA COMPRADORES (CLARA Y AMIGABLE) -->
    <section class="py-24 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-16">
                <span class="text-blue-600 font-bold tracking-wider uppercase text-sm">Para Vecinos</span>
                <h2 class="text-4xl font-extrabold text-gray-900 mt-2">Compra mejor, vive mejor.</h2>
                <p class="text-gray-500 mt-4 max-w-2xl mx-auto">Diseñamos una experiencia de compra pensada para ahorrarte tiempo y dinero.</p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Beneficio 1 -->
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-lg transition group">
                    <div class="w-14 h-14 bg-orange-50 rounded-2xl flex items-center justify-center mb-6 text-orange-500 text-2xl group-hover:scale-110 transition">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Ofertas Flash</h3>
                    <p class="text-gray-500 text-sm">Accede a descuentos explosivos por tiempo limitado. Busca el fueguito 🔥 en el mapa y ahorra.</p>
                </div>
                <!-- Beneficio 2 -->
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-lg transition group">
                    <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mb-6 text-blue-600 text-2xl group-hover:scale-110 transition">
                        <i class="fas fa-bullhorn"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Megáfono Barrial</h3>
                    <p class="text-gray-500 text-sm">¿Buscas algo específico? Pregunta a todos los comercios a la vez y recibe presupuestos al instante.</p>
                </div>
                <!-- Beneficio 3 -->
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 hover:shadow-lg transition group">
                    <div class="w-14 h-14 bg-red-50 rounded-2xl flex items-center justify-center mb-6 text-red-500 text-2xl group-hover:scale-110 transition">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Tus Favoritos</h3>
                    <p class="text-gray-500 text-sm">Guarda los locales que amas. Entérate primero de sus novedades, cambios de horario y promos.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. SECCIÓN PARA VENDEDORES (OSCURA Y PRO) -->
    <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
        <!-- Decoración -->
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-gray-800 via-gray-900 to-black opacity-50"></div>
        
        <div class="max-w-7xl mx-auto px-4 relative z-10">
            <div class="flex flex-col md:flex-row items-center justify-between mb-16 gap-8">
                <div class="md:w-1/2">
                    <span class="text-orange-500 font-bold tracking-wider uppercase text-sm">Para Comercios y Profesionales</span>
                    <h2 class="text-4xl lg:text-5xl font-extrabold mt-2 leading-tight">Potencia tu negocio.<br>Domina tu zona.</h2>
                </div>
                <div class="md:w-1/2 md:text-right">
                    <p class="text-gray-400 text-lg max-w-md ml-auto">
                        Herramientas profesionales para vender más, fidelizar clientes y gestionar tu stock desde el celular o la web.
                    </p>
                    <a href="https://panel.cercamio.app" class="inline-block mt-6 bg-white text-gray-900 px-6 py-3 rounded-lg font-bold hover:bg-gray-200 transition">
                        Acceder al Panel Web
                    </a>
                </div>
            </div>

            <div class="grid md:grid-cols-4 gap-6">
                <div class="bg-gray-800/50 p-6 rounded-2xl border border-gray-700 hover:bg-gray-800 transition">
                    <i class="fas fa-camera text-purple-400 text-3xl mb-4"></i>
                    <h3 class="font-bold text-lg mb-2">Historias</h3>
                    <p class="text-gray-400 text-xs">Sube fotos de tus productos o trabajos realizados al feed Explorar.</p>
                </div>
                <div class="bg-gray-800/50 p-6 rounded-2xl border border-gray-700 hover:bg-gray-800 transition">
                    <i class="fas fa-rocket text-amber-400 text-3xl mb-4"></i>
                    <h3 class="font-bold text-lg mb-2">Misiones Rockstar</h3>
                    <p class="text-gray-400 text-xs">Completa retos, sube de nivel y desbloquea beneficios premium gratis.</p>
                </div>
                <div class="bg-gray-800/50 p-6 rounded-2xl border border-gray-700 hover:bg-gray-800 transition">
                    <i class="fas fa-tags text-green-400 text-3xl mb-4"></i>
                    <h3 class="font-bold text-lg mb-2">Marketing</h3>
                    <p class="text-gray-400 text-xs">Crea Ofertas Flash y Especiales para liquidar stock rápidamente.</p>
                </div>
                <div class="bg-gray-800/50 p-6 rounded-2xl border border-gray-700 hover:bg-gray-800 transition">
                    <i class="fas fa-comments text-blue-400 text-3xl mb-4"></i>
                    <h3 class="font-bold text-lg mb-2">Interacción</h3>
                    <p class="text-gray-400 text-xs">Responde preguntas y atiende solicitudes del Megáfono en tiempo real.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- NUEVA SECCIÓN: EDUCACIÓN DIGITAL (HUMANIZANDO LA TECNOLOGÍA) -->
    <section class="py-24 bg-white border-t border-gray-100">
        <div class="max-w-6xl mx-auto px-4">
            
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-orange-500 font-bold tracking-wider uppercase text-sm">El Futuro es Hoy</span>
                <h2 class="text-3xl lg:text-4xl font-extrabold text-gray-900 mt-2 mb-6">
                    Digitalizarse no significa complicarse.
                </h2>
                <p class="text-lg text-gray-500 leading-relaxed">
                    En esta era, la tecnología es el puente entre tu negocio y tus vecinos. 
                    Diseñamos CercaMío para que sea tan natural como una charla en el mostrador.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-10">
                
                <!-- Pila 1: Importancia -->
                <div class="relative bg-blue-50/50 p-8 rounded-3xl border border-blue-100 hover:shadow-lg transition duration-300">
                    <div class="absolute -top-6 left-8 bg-blue-600 text-white w-12 h-12 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/30">
                        <i class="fas fa-globe text-xl"></i>
                    </div>
                    <h3 class="mt-4 text-xl font-bold text-gray-900 mb-3">¿Por qué ahora?</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Tus vecinos ya están en el celular. Digitalizar tu vidriera permite que te encuentren 24/7, incluso cuando tienes la persiana baja. No pierdas ventas por no ser visible.
                    </p>
                </div>

                <!-- Pila 2: Accesibilidad (Edad) -->
                <div class="relative bg-orange-50/50 p-8 rounded-3xl border border-orange-100 hover:shadow-lg transition duration-300">
                    <div class="absolute -top-6 left-8 bg-orange-500 text-white w-12 h-12 rounded-2xl flex items-center justify-center shadow-lg shadow-orange-500/30">
                        <i class="fas fa-universal-access text-xl"></i>
                    </div>
                    <h3 class="mt-4 text-xl font-bold text-gray-900 mb-3">Para todas las edades</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        ¿Sabes usar WhatsApp? Entonces sabes usar CercaMío. Interfaz grande, clara e intuitiva. Sin palabras raras ni menús complicados. Tecnología apta para todo público.
                    </p>
                </div>

                <!-- Pila 3: Beneficios Reales -->
                <div class="relative bg-green-50/50 p-8 rounded-3xl border border-green-100 hover:shadow-lg transition duration-300">
                    <div class="absolute -top-6 left-8 bg-green-600 text-white w-12 h-12 rounded-2xl flex items-center justify-center shadow-lg shadow-green-500/30">
                        <i class="fas fa-chart-line text-xl"></i>
                    </div>
                    <h3 class="mt-4 text-xl font-bold text-gray-900 mb-3">Beneficios Reales</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        Para el <strong>Comercio</strong>: Control total y nuevos clientes.<br>
                        Para el <strong>Vecino</strong>: Ahorro de tiempo y dinero.<br>
                        Para el <strong>Barrio</strong>: El dinero circula y crece dentro de la comunidad local.
                    </p>
                </div>

            </div>

            <!-- Frase de cierre -->
            <div class="mt-16 text-center">
                <p class="text-2xl font-serif italic text-gray-400">
                    "La tecnología no reemplaza al barrio, lo conecta."
                </p>
            </div>

        </div>
    </section>

    <!-- SECCIÓN: EVOLUCIÓN CONTINUA (COMMITMENT) 🔄 -->
    <section class="py-16 bg-slate-50 border-y border-gray-200">
        <div class="max-w-7xl mx-auto px-4">
            
            <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
                
                <!-- TEXTO MANIFIESTO -->
                <div class="lg:w-1/2">
                    <div class="inline-flex items-center gap-2 mb-4">
                        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-widest">Estado: Desarrollo Activo</span>
                    </div>
                    <h2 class="text-3xl font-extrabold text-slate-900 mb-4">
                        No somos una app estática.<br>
                        <span class="text-blue-600">Somos un ecosistema vivo.</span>
                    </h2>
                    <p class="text-gray-600 text-lg leading-relaxed mb-6">
                        CercaMío crece contigo. Nuestro equipo lanza actualizaciones constantes basadas en lo que tú necesitas.
                    </p>
                    
                    <!-- Puntos Clave -->
                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <i class="fas fa-sync-alt text-blue-500 mt-1"></i>
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm">Mejora Continua</h4>
                                <p class="text-xs text-slate-500">Nuevas funciones y optimizaciones cada mes.</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <i class="fas fa-comment-dots text-orange-500 mt-1"></i>
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm">Construimos Juntos</h4>
                                <p class="text-xs text-slate-500">
                                    Analizamos con el equipo nuevas herramientas para implementar y desarrollar soluciones que beneficien a toda la comunidad.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- WIDGET DE "LO QUE SE VIENE" -->
                <div class="lg:w-1/2 w-full">
                    <div class="bg-white p-6 rounded-2xl shadow-xl border border-gray-100 relative overflow-hidden">
                        <div class="absolute top-0 right-0 bg-blue-600 text-white text-[10px] font-bold px-3 py-1 rounded-bl-xl">
                            ROADMAP TÉCNICO
                        </div>
                        
                        <h3 class="font-bold text-gray-900 mb-6 flex items-center gap-2">
                            <i class="fas fa-code-branch text-gray-400"></i> Próximas Actualizaciones
                        </h3>

                        <div class="space-y-4">
                            <!-- Item 1: Done -->
                            <div class="flex items-center gap-4 opacity-50">
                                <div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center text-green-600 flex-shrink-0">
                                    <i class="fas fa-check text-xs"></i>
                                </div>
                                <span class="text-sm text-gray-500 line-through">Pagos con Mercado Pago</span>
                            </div>

                            <!-- Item 2: Done -->
                            <div class="flex items-center gap-4 opacity-50">
                                <div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center text-green-600 flex-shrink-0">
                                    <i class="fas fa-check text-xs"></i>
                                </div>
                                <span class="text-sm text-gray-500 line-through">Agenda de Turnos</span>
                            </div>

                            <!-- Item 3: In Progress -->
                            <div class="flex items-center gap-4 bg-blue-50 p-3 rounded-lg border border-blue-100">
                                <div class="w-6 h-6 rounded-full bg-blue-600 flex items-center justify-center text-white flex-shrink-0 animate-spin-slow">
                                    <i class="fas fa-spinner text-xs"></i>
                                </div>
                                <div>
                                    <span class="text-sm font-bold text-blue-900 block">Mercado P2P (Compra/Venta usados)</span>
                                    <span class="text-[10px] text-blue-600 font-medium">EN DESARROLLO</span>
                                </div>
                            </div>

                            <!-- Item 4: Next -->
                            <div class="flex items-center gap-4">
                                <div class="w-6 h-6 rounded-full border-2 border-dashed border-gray-300 flex items-center justify-center text-gray-400 flex-shrink-0">
                                    <i class="fas fa-truck text-xs"></i>
                                </div>
                                <span class="text-sm text-gray-500">Seguimiento de Delivery en vivo</span>
                            </div>

                            <!-- Item 5: Future (Infinite) -->
                            <div class="flex items-center gap-4 opacity-70">
                                <div class="w-6 h-6 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-400 flex-shrink-0 animate-pulse">
                                    <i class="fas fa-plus text-[10px]"></i>
                                </div>
                                <span class="text-sm text-slate-500 font-medium italic">Más herramientas en camino...</span>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 6. NUESTRO PROPÓSITO (IMPACTO SOCIAL & ROADMAP) ❤️ -->
    <section class="py-24 bg-gradient-to-br from-indigo-900 to-slate-900 text-white relative overflow-hidden">
        
        <!-- Decoración sutil -->
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
        <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-white to-transparent opacity-10"></div>

