---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import appMockup from '../assets/app_mockup.png';
---

<Layout title="CercaMío | La SuperApp Argentina">
	
    <!-- 1. HERO SECTION (V3.1 - NACIONAL ARGENTINA 🇦🇷) -->
    <header class="relative pt-32 pb-20 lg:pt-48 lg:pb-40 overflow-hidden">
        
        <!-- Fondo Premium (Mesh Gradient) -->
        <div class="absolute inset-0 bg-white">
            <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-blue-100/50 rounded-full blur-[100px] opacity-70"></div>
            <div class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-orange-50/50 rounded-full blur-[120px] opacity-60"></div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
                
                <!-- COLUMNA IZQUIERDA: COPYWRITING DE IMPACTO -->
                <div class="w-full lg:w-1/2 text-center lg:text-left">
                    
                    <!-- Badge de Estado -->
                    <div class="inline-flex items-center gap-2 px-4 py-2 mb-8 bg-white border border-gray-200 rounded-full shadow-sm hover:shadow-md transition-shadow cursor-default">
                        <span class="relative flex h-3 w-3">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                        </span>
                        <!-- 🔥 CAMBIO: Bandera Argentina para identidad nacional -->
                        <span class="text-xs font-bold tracking-wider text-gray-600 uppercase">Disponible en Argentina 🇦🇷</span>
                    </div>
                    
                    <!-- Título Principal -->
                    <h1 class="text-5xl lg:text-7xl font-extrabold text-slate-900 leading-[1.1] mb-6 tracking-tight">
                        Tu ciudad, <br>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-orange-500">
                            conectada.
                        </span>
                    </h1>
                    
                    <!-- 🔥 CAMBIO: Texto Nacional sin connotación policial -->
                    <p class="text-lg lg:text-xl text-slate-600 mb-10 leading-relaxed max-w-xl mx-auto lg:mx-0">
                        Llegó la primera <strong>SuperApp Argentina</strong>. Unimos vecinos, comercios y oficios de todo el país, sin intermediarios y con precios justos.
                    </p>
                    
                    <!-- BOTONES DE ACCIÓN (CONVERSION) -->
                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center">
                        
                        <!-- Botón Google Play -->
                        <a href="https://play.google.com/store/apps/details?id=com.cercamio.app" target="_blank" 
                           class="group flex items-center bg-gray-900 text-white px-7 py-3.5 rounded-xl hover:bg-black transition-all shadow-xl hover:shadow-2xl hover:-translate-y-1 active:scale-95 duration-300">
                            <i class="fab fa-google-play text-3xl mr-3 text-white group-hover:text-green-400 transition-colors"></i>
                            <div class="text-left">
                                <div class="text-[10px] uppercase tracking-wider opacity-80">Descárgala en</div>
                                <div class="font-bold text-lg leading-none">Google Play</div>
                            </div>
                        </a>

                        <!-- Botón Secundario -->
                        <a href="https://panel.cercamio.app" class="px-7 py-4 rounded-xl font-bold text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition flex items-center gap-2">
                            Soy Vendedor <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                    </div>

                </div>

                <!-- COLUMNA DERECHA: MOCKUP 3D INTERACTIVO -->
                <div class="w-full lg:w-1/2 flex justify-center relative mt-16 lg:mt-0 perspective-1000">
                    
                    <!-- Glow Trasero -->
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-blue-500/20 rounded-full blur-[80px]"></div>

                    <div class="relative transform transition-transform duration-700 hover:scale-105 hover:rotate-0 rotate-[-3deg]">
                        
                        <!-- EL TELÉFONO (Componente Astro) -->
                        <Image 
                            src={appMockup} 
                            alt="App CercaMío en funcionamiento" 
                            class="w-[280px] md:w-[380px] lg:w-[420px] h-auto mx-auto relative z-10 drop-shadow-[0_20px_45px_rgba(0,0,0,0.6)] transition-all duration-500 hover:drop-shadow-[0_35px_65px_rgba(0,0,0,0.7)]"
                            width={800} 
                            quality="high"
                            loading="eager" 
                        />

                        <!-- WIDGET FLOTANTE 1 -->
                        <div class="absolute -right-2 md:-right-6 top-10 md:top-20 bg-white/95 backdrop-blur-md p-3 rounded-2xl shadow-lg border border-white/40 animate-bounce z-20 scale-90 md:scale-100" style="animation-duration: 3s;">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center text-orange-600">
                                    <i class="fas fa-fire"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-500 font-bold">Oferta Flash</p>
                                    <p class="text-sm font-black text-gray-800">-50% OFF</p>
                                </div>
                            </div>
                        </div>

                        <!-- WIDGET FLOTANTE 2 -->
                        <div class="absolute -left-2 md:-left-10 bottom-10 md:bottom-32 bg-white/95 backdrop-blur-md p-3 rounded-2xl shadow-lg border border-white/40 z-20 animate-pulse scale-90 md:scale-100" style="animation-duration: 4s;">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center text-purple-600">
                                    <i class="fas fa-calendar-check"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-500 font-bold">Turno Confirmado</p>
                                    <p class="text-sm font-black text-gray-800">Hoy 15:00hs</p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- 2. MAPA INTELIGENTE (DESTACADO V2) -->
    <section class="py-24 bg-white relative">
        <div class="max-w-7xl mx-auto px-4">
            <div class="bg-gradient-to-br from-blue-600 to-blue-800 rounded-[2.5rem] p-8 md:p-16 text-white shadow-2xl relative overflow-hidden group">
                
                <!-- Fondo decorativo mapa -->
                <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/map-markers.png')]"></div>
                
                <div class="relative z-10 flex flex-col md:flex-row items-center gap-12">
                    <div class="md:w-3/5">
                        <div class="inline-flex items-center gap-2 bg-blue-500/30 backdrop-blur-sm px-4 py-1.5 rounded-full text-blue-100 text-sm font-bold mb-6 border border-blue-400/30">
                            <i class="fas fa-map-marked-alt"></i> La función estrella
                        </div>
                        <h2 class="text-3xl md:text-5xl font-extrabold mb-6 leading-tight">
                            Ser visto por toda la ciudad <br>nunca fue tan fácil.
                        </h2>
                        <p class="text-blue-100 text-lg md:text-xl mb-8 leading-relaxed max-w-2xl">
                            Ya sea que tengas un Local, vendas tortas desde casa o seas plomero. 
                            Nuestro <strong>Mapa Inteligente</strong> y el feed <strong>Explorar</strong> te ponen en el radar de miles de vecinos en tiempo real.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <div class="bg-white/10 backdrop-blur-md px-5 py-3 rounded-xl border border-white/10 flex items-center gap-3">
                                <i class="fas fa-store text-orange-400"></i>
                                <span class="font-medium">Locales</span>
                            </div>
                            <div class="bg-white/10 backdrop-blur-md px-5 py-3 rounded-xl border border-white/10 flex items-center gap-3">
                                <i class="fas fa-tools text-green-400"></i>
                                <span class="font-medium">Servicios</span>
                            </div>
                            <div class="bg-white/10 backdrop-blur-md px-5 py-3 rounded-xl border border-white/10 flex items-center gap-3">
                                <i class="fas fa-cookie-bite text-pink-400"></i>
                                <span class="font-medium">Emprendedores</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Icono Gigante 3D -->
                    <div class="md:w-2/5 flex justify-center">
                        <div class="w-48 h-48 md:w-64 md:h-64 bg-white/10 backdrop-blur-xl rounded-full flex items-center justify-center border border-white/20 shadow-[0_0_50px_rgba(255,255,255,0.2)] group-hover:scale-110 transition duration-500">
                            <i class="fas fa-location-dot text-8xl md:text-9xl text-orange-500 drop-shadow-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. SECCIÓN PARA VECINOS (COMPRADORES) - DISEÑO IMPACTO V2.0 🛍️ -->
    <section class="py-32 bg-slate-50 relative">
        
        <!-- Decoración de fondo sutil -->
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-100/40 rounded-full blur-[120px] -z-10"></div>
        <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-orange-100/40 rounded-full blur-[120px] -z-10"></div>

        <div class="max-w-7xl mx-auto px-4 relative z-10">
            
            <div class="text-center mb-20">
                <span class="inline-block py-1 px-3 rounded-lg bg-blue-100 text-blue-700 text-xs font-bold tracking-widest uppercase mb-4">
                    Experiencia CercaMío
                </span>
                <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight">
                    Compra inteligente,<br> vive mejor.
                </h2>
                <p class="text-xl text-slate-500 mt-6 max-w-2xl mx-auto leading-relaxed">
                    Diseñamos herramientas exclusivas para que ahorres dinero y encuentres soluciones en tiempo récord.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-10">
                
                <!-- CARD 1: OFERTAS FLASH (FUEGO) 🔥 -->
                <div class="group bg-white p-10 rounded-[2.5rem] shadow-xl border border-slate-100 hover:border-orange-200 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-orange-50 rounded-bl-full -mr-10 -mt-10 transition-transform group-hover:scale-110"></div>
                    
                    <div class="w-16 h-16 bg-gradient-to-br from-orange-400 to-red-500 rounded-2xl flex items-center justify-center mb-8 text-white text-3xl shadow-lg shadow-orange-500/30 relative z-10">
                        <i class="fas fa-fire"></i>
                    </div>
                    
                    <h3 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-orange-600 transition-colors">Ofertas Flash</h3>
                    <p class="text-slate-600 leading-relaxed">
                        El mapa se enciende. Accede a liquidaciones y descuentos agresivos que duran solo 24hs. <br>
                        <span class="text-sm font-bold text-orange-600 mt-2 block">Busca el fueguito en el mapa.</span>
                    </p>
                </div>

                <!-- CARD 2: MEGÁFONO (COMUNIDAD) 📢 -->
                <div class="group bg-white p-10 rounded-[2.5rem] shadow-xl border border-slate-100 hover:border-blue-200 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-bl-full -mr-10 -mt-10 transition-transform group-hover:scale-110"></div>
                    
                    <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center mb-8 text-white text-3xl shadow-lg shadow-blue-500/30 relative z-10">
                        <i class="fas fa-bullhorn"></i>
                    </div>
                    
                    <h3 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-blue-600 transition-colors">Megáfono Barrial</h3>
                    <p class="text-slate-600 leading-relaxed">
                        ¿Buscas algo específico? Lanza una alerta a los comercios de tu zona. <br>
                        <span class="text-sm font-bold text-blue-600 mt-2 block">"Busco plomero urgente" o "Alguien tiene tornillos de 3/4?"</span>
                    </p>
                </div>

                <!-- CARD 3: SOCIAL (HISTORIAS) 📸 -->
                <div class="group bg-white p-10 rounded-[2.5rem] shadow-xl border border-slate-100 hover:border-purple-200 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-purple-50 rounded-bl-full -mr-10 -mt-10 transition-transform group-hover:scale-110"></div>
                    
                    <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl flex items-center justify-center mb-8 text-white text-3xl shadow-lg shadow-purple-500/30 relative z-10">
                        <i class="fas fa-heart"></i>
                    </div>
                    
                    <h3 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-purple-600 transition-colors">Tu Feed Local</h3>
                    <p class="text-slate-600 leading-relaxed">
                        Sigue a tus favoritos y mira sus <strong>Historias</strong> diarias. Novedades, ingresos de stock y cambios de horario en tiempo real.
                    </p>
                </div>

            </div>
        </div>
    </section>

   <!-- 5. SECCIÓN PARA VENDEDORES (COMANDO CENTRAL) - DARK MODE 💻 -->
    <section class="py-32 bg-[#0B1121] text-white relative overflow-hidden">
        
        <!-- Grid de fondo animado (Efecto Tech) -->
        <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.ai/noise.svg')] opacity-20 mix-blend-soft-light"></div>
        <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-blue-600/10 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-purple-600/10 rounded-full blur-[100px] translate-y-1/3 -translate-x-1/4"></div>
        
        <div class="max-w-7xl mx-auto px-4 relative z-10">
            
            <!-- HEADER -->
            <div class="flex flex-col lg:flex-row items-end justify-between mb-20 gap-10">
                <div class="lg:w-2/3">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/30 bg-blue-500/10 text-blue-400 text-xs font-bold tracking-widest uppercase mb-6">
                        <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
                        Para Comercios y Profesionales
                    </div>
                    <h2 class="text-4xl lg:text-6xl font-black leading-tight">
                        El Sistema Operativo <br>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">de tu Negocio.</span>
                    </h2>
                    <p class="text-slate-400 text-lg mt-6 max-w-2xl leading-relaxed">
                        Olvídate del cuaderno y el Excel. Gestiona <strong>Stock, Turnos, Pedidos y Cobros</strong> desde una plataforma unificada. 
                        Tu negocio en el celular, tu administración en la PC.
                    </p>
                </div>
                
                <!-- CTA PANEL -->
                <div class="lg:w-1/3 lg:text-right">
                    <a href="https://panel.cercamio.app" target="_blank" class="group relative inline-flex items-center justify-center px-8 py-4 font-bold text-white transition-all duration-200 bg-blue-600 font-lg rounded-xl hover:bg-blue-500 hover:shadow-lg hover:shadow-blue-500/40 focus:outline-none ring-offset-2 focus:ring-2 ring-blue-400">
                        <span>Acceder al Panel Web</span>
                        <i class="fas fa-laptop-code ml-3 group-hover:translate-x-1 transition-transform"></i>
                        <div class="absolute -top-3 -right-3">
                            <span class="relative flex h-4 w-4">
                              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                              <span class="relative inline-flex rounded-full h-4 w-4 bg-red-500 text-[8px] items-center justify-center text-white font-bold">1</span>
                            </span>
                        </div>
                    </a>
                    <p class="text-xs text-slate-500 mt-3 font-medium">Gratis para empezar.</p>
                </div>
            </div>

            <!-- GRILLA DE PODERES (5 CARDS - DISEÑO FLEX CENTRADO) -->
            <div class="flex flex-wrap justify-center gap-6">
                
                <!-- CARD 1: HÍBRIDO (Blue) -->
                <div class="w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] bg-white/5 backdrop-blur-md p-8 rounded-3xl border border-white/10 hover:bg-white/10 hover:border-blue-500/30 transition-all duration-300 group">
                    <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-blue-500/20 group-hover:scale-110 transition-transform">
                        <i class="fas fa-layer-group text-2xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Motor Híbrido</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        ¿Vendes productos? Controla tu <strong>Stock</strong>. <br>
                        ¿Ofreces servicios? Organiza tu <strong>Agenda de Turnos</strong>. <br>
                        Todo en la misma app.
                    </p>
                </div>

                <!-- CARD 2: FINTECH (Green) -->
                <div class="w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] bg-white/5 backdrop-blur-md p-8 rounded-3xl border border-white/10 hover:bg-white/10 hover:border-green-500/30 transition-all duration-300 group">
                    <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-green-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-green-500/20 group-hover:scale-110 transition-transform">
                        <i class="fas fa-qrcode text-2xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Cobros & QR</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Integra <strong>Mercado Pago</strong>. Genera QRs interoperables para cobrar presencialmente y recibe el dinero al instante.
                    </p>
                </div>

                <!-- CARD 3: HISTORIAS (Pink) - VISIBILIDAD -->
                <div class="w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] bg-white/5 backdrop-blur-md p-8 rounded-3xl border border-white/10 hover:bg-white/10 hover:border-pink-500/30 transition-all duration-300 group relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-20 h-20 bg-pink-500/20 rounded-full blur-2xl group-hover:bg-pink-500/30 transition"></div>
                    <div class="w-14 h-14 bg-gradient-to-br from-pink-500 to-purple-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-pink-500/20 group-hover:scale-110 transition-transform">
                        <i class="fas fa-camera text-2xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Visibilidad Total</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Sube una <strong>Historia</strong> y aparece automáticamente en el mapa de miles de vecinos a tu alrededor. Sin necesidad de seguidores.
                    </p>
                </div>

                <!-- CARD 4: MARKETING TOOLS (Red/Orange) - RESTAURADA 🔥 -->
                <div class="w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] bg-white/5 backdrop-blur-md p-8 rounded-3xl border border-white/10 hover:bg-white/10 hover:border-red-500/30 transition-all duration-300 group">
                    <div class="w-14 h-14 bg-gradient-to-br from-red-500 to-orange-500 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-red-500/20 group-hover:scale-110 transition-transform">
                        <i class="fas fa-bullhorn text-2xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Growth Tools</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Liquida stock con <strong>Ofertas Flash</strong> (ícono de fuego en el mapa) y fideliza clientes enviando <strong>Cupones de Descuento</strong> directos.
                    </p>
                </div>

                <!-- CARD 5: GAMIFICACIÓN (Amber/Gold) -->
                <div class="w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] bg-white/5 backdrop-blur-md p-8 rounded-3xl border border-white/10 hover:bg-white/10 hover:border-amber-500/30 transition-all duration-300 group">
                    <div class="w-14 h-14 bg-gradient-to-br from-amber-400 to-yellow-500 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-amber-500/20 group-hover:scale-110 transition-transform">
                        <i class="fas fa-trophy text-2xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Misión Rockstar</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        Completa retos, consigue "Favoritos" y desbloquea meses de <strong>Plan Premium GRATIS</strong>. Tu esfuerzo paga tus cuentas.
                    </p>
                </div>

            </div>
        </div>
    </section>

    <!-- NUEVA SECCIÓN: TECNOLOGÍA HUMANA (V2.0 - CLARIDAD TOTAL) 🧠 -->
    <section class="py-24 bg-white border-t border-slate-100 relative overflow-hidden">
        
        <!-- Fondo Decorativo -->
        <div class="absolute right-0 top-0 w-64 h-64 bg-slate-50 rounded-bl-[100px] -z-10"></div>
        <div class="absolute left-0 bottom-0 w-40 h-40 bg-blue-50 rounded-tr-[80px] -z-10"></div>

        <div class="max-w-7xl mx-auto px-4">
            
            <div class="text-center max-w-3xl mx-auto mb-20">
                <span class="text-blue-600 font-bold tracking-wider uppercase text-sm mb-3 block">Simplicidad Radical</span>
                <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight mb-6">
                    Tecnología que habla<br>tu mismo idioma.
                </h2>
                <p class="text-xl text-slate-500 leading-relaxed">
                    Eliminamos la barrera digital. Si sabes mandar un mensaje, sabes usar CercaMío. 
                    Diseñado para que desde el joven experto hasta el abuelo del barrio puedan conectarse.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                
                <!-- CARD 1: CERO CURVA DE APRENDIZAJE -->
                <div class="group bg-white p-8 rounded-[2rem] border border-slate-100 shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 relative">
                    <div class="w-16 h-16 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center mb-6 text-3xl group-hover:scale-110 transition">
                        <i class="fab fa-whatsapp"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-slate-900 mb-4">Tan fácil como chatear</h3>
                    <p class="text-slate-600 text-base leading-relaxed">
                        Olvídate de menús complicados. La interfaz es grande, clara e intuitiva. 
                        <strong>No necesitas ser experto en tecnología</strong> para vender tus productos o pedir un servicio.
                    </p>
                </div>

                <!-- CARD 2: VISIBILIDAD PASIVA -->
                <div class="group bg-white p-8 rounded-[2rem] border border-slate-100 shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 relative">
                    <div class="w-16 h-16 bg-orange-100 text-orange-600 rounded-2xl flex items-center justify-center mb-6 text-3xl group-hover:scale-110 transition">
                        <i class="fas fa-store-alt"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-slate-900 mb-4">Tu vidriera, abierta 24hs</h3>
                    <p class="text-slate-600 text-base leading-relaxed">
